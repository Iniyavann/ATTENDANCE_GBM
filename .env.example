# Copy this file to .env and fill in real values before running the app.
# .env is ignored by git - never commit real secrets.

# Port the server listens on
PORT=3000

# Long random string used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# How long an admin login stays valid
JWT_EXPIRES_IN=12h

# Optional bcrypt hash used when bootstrapping the first owner row. Leave
# unset to use the built-in bcrypt bootstrap hash and change it after login.
# OWNER_PASSWORD_HASH=

# Optional: force a specific timezone for "today" / late-status calculations
# (defaults to the server machine's own timezone if left blank)
# TZ=Asia/Kolkata

# Office location used for GPS attendance verification
OFFICE_LAT=12.932936802635343
OFFICE_LNG=77.6140108624427
OFFICE_RADIUS_METERS=100

# SQLite database file location
DB_FILE=./data/gbm-attendance.db

# Folder where attendance photos are stored
UPLOADS_DIR=./uploads/attendance

# Optional: auto-creates the first admin account on server startup, only if
# no admin exists yet. Useful on hosts that don't give you a terminal
# (e.g. Render's free tier) - if you can run "npm run create-admin"
# instead, you don't need these.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-this-passcode
